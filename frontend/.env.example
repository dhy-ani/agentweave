# Copy to .env.local and fill in. Never commit real values.

# Backend base URL (local FastAPI or the deployed Vercel URL).
REACT_APP_API_URL=http://localhost:8001

# Option A: real Firebase project (Project settings > General > Your apps).
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Option B: no Firebase account needed. Run `npm run emulators` in another
# terminal and set this to true; sign up with any email, e.g. the local
# test account demo@agentweave.test / weave-demo-2026 (emulator only).
REACT_APP_USE_AUTH_EMULATOR=false
