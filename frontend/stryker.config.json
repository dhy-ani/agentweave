{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "create-react-app",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.js",
    "src/config.js",
    "src/components/FashionCard.jsx",
    "src/components/SavedBoard.jsx",
    "src/components/ShoppingPanel.jsx",
    "src/components/Dashboard.jsx",
    "!src/**/*.test.js",
    "!src/**/*.test.jsx",
    "!src/lib/resizeImage.js:13-40"
  ],
  "ignoreStatic": true,
  "reporters": [
    "html",
    "clear-text",
    "progress",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 85,
    "low": 70,
    "break": 60
  },
  "concurrency": 4,
  "timeoutMS": 15000,
  "tempDirName": "stryker-tmp",
  "plugins": [
    "@stryker-mutator/*",
    "./stryker/presentation-ignorer.mjs"
  ],
  "ignorers": [
    "presentation"
  ]
}
