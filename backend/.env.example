# Copy to backend/.env for local development (loaded by settings.py without
# overriding variables already set in the environment). On Vercel, set these
# in Project Settings -> Environment Variables instead.

# --- Firebase Auth ----------------------------------------------------------
# The backend has no database: user data lives in Firestore (written by the
# frontend). The /closet endpoints verify the Firebase ID token sent as
# "Authorization: Bearer <token>" and take the uid from it.
# Required for /closet (503 without it). Production: agentweave-e9cd8.
FIREBASE_PROJECT_ID=demo-agentweave
# Local development only: accept the Auth emulator's unsigned tokens
# (a warning is logged at startup). NEVER set this in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- CORS -------------------------------------------------------------------
# Comma-separated allowed origins. Default:
# http://localhost:3000,http://localhost:3100,https://dhy-ani.github.io
# CORS_ORIGINS=https://dhy-ani.github.io,http://localhost:3000

# --- Uploaded closet images -------------------------------------------------
# Set to store uploads in a PUBLIC Vercel Blob store (required on Vercel for
# uploads to persist), at closet/{uid}/{item_id}.jpg. Unset: local files under
# backend/uploads/closet/, served at /closet-images/{uid}/{item_id}.jpg.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
# Local upload directory override (LocalStorage only).
# AGENTWEAVE_UPLOAD_DIR=
# Maximum accepted image upload in MB (Vercel's request body limit is 4.5).
# AGENTWEAVE_MAX_UPLOAD_MB=4.5

# --- Models -----------------------------------------------------------------
# onnx (default, serving) or torch (training/eval scripts; needs requirements-train.txt).
# AGENTWEAVE_BACKEND=onnx
# Directory checked first for the ONNX files listed in ai/models/manifest.json.
# AGENTWEAVE_MODEL_DIR=ai/models
# Where missing models are downloaded to (must be writable; /tmp on Vercel).
# AGENTWEAVE_MODEL_CACHE_DIR=/tmp/agentweave-models
# Release URL the models are downloaded from (verified against manifest.json).
# AGENTWEAVE_MODEL_BASE_URL=https://github.com/dhy-ani/agentweave/releases/download/models-v1
# Vercel build only: set to 0 to skip bundling models and download them at runtime.
# AGENTWEAVE_BUNDLE_MODELS=1
# ONNX Runtime intra-op threads (default: one per physical core).
# AGENTWEAVE_ORT_THREADS=
# Disable torch dynamic int8 quantization in the torch backend.
# AGENTWEAVE_NO_QUANTIZE=1

# --- Static images ----------------------------------------------------------
# Directory served at /images (default: static/images, then ../datasets/processedImages).
# AGENTWEAVE_IMAGE_DIR=

# --- Logging ----------------------------------------------------------------
# LOG_LEVEL=INFO
